NODE_ENV=development
PORT=5000

# --- Supabase ----------------------------------------------------------------
# Copy from Supabase Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_starts_with_ey

# --- AI Provider -------------------------------------------------------------
# Provider, model and base URL are fixed in code (config/constants.js).
# Only the API key is configurable. Leave blank to use the stub provider.
AI_API_KEY=
