NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
BODY_JSON_LIMIT_MB=2

# --- Supabase ----------------------------------------------------------------
# Copy from Supabase Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_starts_with_ey
# Optional, used for manual JWT verification (fallback uses getUser call)
SUPABASE_JWT_SECRET=optional

# --- CORS --------------------------------------------------------------------
# Comma-separated list. * = allow all (dev only).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI Provider -------------------------------------------------------------
# Provider: stub | openai | anthropic | gemini
AI_PROVIDER=stub
# Required when AI_PROVIDER != stub
AI_API_KEY=
AI_MODEL=
# Optional override for compatible providers (e.g. local proxy)
AI_BASE_URL=

# --- Exposed to frontend via env (optional here, docs only) -----------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
